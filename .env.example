# ============================================================================
#  NOVA AI FINANCE — FRONTEND ENVIRONMENT (template)
#
#  Copy this file to `.env` IN THIS SAME FOLDER (the project root, next to
#  package.json), then fill in your own values.
#
#  ⚠️ THIS FILE MUST LIVE IN THE PROJECT ROOT, NOT IN src/.
#  Vite only loads .env files from the directory it is started in. The existing
#  src/.env and src/.env.example were never read by Vite at all, which is why
#  VITE_API_BASE_URL appeared to have no effect. They are left in place so
#  nothing breaks, but the root copy is the one that counts.
#
#  ⚠️ EVERY VITE_* VALUE IS BAKED INTO THE JAVASCRIPT BUNDLE AND IS PUBLIC.
#  Never put a secret here — no Google Client Secret, no JWT secret, no
#  Cloudinary or Mailtrap credentials, no database password. Those belong only
#  in the backend's environment (your IntelliJ run configuration).
# ============================================================================

# ---------------------------------------------------------------------------
# Base URL of your Spring Boot backend, including the /api/v1 prefix.
# Must match server.port + server.servlet.context-path in application-dev.yml.
# Change this only if you run the backend somewhere other than localhost:8080.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# localStorage key holding the JWT access token. Any string works; it only has
# to stay stable, because changing it signs everyone out on next load.
# ---------------------------------------------------------------------------
VITE_AUTH_TOKEN_STORAGE_KEY=nova_access_token


# ============================================================================
#  GOOGLE SIGN-IN — NOTHING TO ADD HERE
#
#  There is deliberately no VITE_GOOGLE_CLIENT_ID in this file. The Google flow
#  is entirely server-side: the browser is sent to the BACKEND at
#  {backend origin}/oauth2/authorization/google, and Spring Security attaches
#  the client id itself. The frontend never sees it.
#
#  So your Google credentials go ONLY in the backend environment — the same
#  IntelliJ run configuration that already holds JWT_SECRET and DB_PASSWORD:
#
#      GOOGLE_CLIENT_ID       = <your OAuth 2.0 Client ID>.apps.googleusercontent.com
#      GOOGLE_CLIENT_SECRET   = <your OAuth 2.0 Client Secret>
#
#  And in Google Cloud Console → APIs & Services → Credentials, the
#  "Authorized redirect URI" must be exactly:
#
#      http://localhost:8080/login/oauth2/code/google
#
#  (That is the BACKEND, with no /api/v1 — Spring's callback lives at the
#  servlet root. Do NOT enter the frontend URL there. The frontend address
#  http://localhost:5173/oauth2/callback is configured separately on the
#  backend as finance.auth.frontend-redirect-uri.)
# ============================================================================
